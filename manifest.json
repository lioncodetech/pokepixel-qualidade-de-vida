{
  "manifest_version": 3,
  "name": "PokePixel - qualidade de vida",
  "version": "1.39.1",
  "key": "",
  "description": "As dezoito ferramentas de qualidade de vida do PokePixel num pacote so, com um menu para ligar e desligar cada uma. Alt+Q abre o menu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pokepixel.nietore.com/*"
      ],
      "js": [
        "nucleo.js",
        "ocultar-popups.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokepixel.nietore.com/*"
      ],
      "js": [
        "agenda.js",
        "config.js",
        "telegram.js",
        "senha.js",
        "loja-rapida.js",
        "venda-rapida.js",
        "layout-padrao.js",
        "times.js",
        "gym.js",
        "cacadas.js",
        "tipos.js",
        "escada.js",
        "arena.js",
        "rampage.js",
        "eventos.js",
        "ilhas.js",
        "raridades.js",
        "genetica.js",
        "expedicao.js",
        "awakening.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pokepixel.nietore.com/*"
      ],
      "js": [
        "nucleo-main.js",
        "sem-grafico.js",
        "raridades-main.js",
        "cacadas-main.js",
        "escada-main.js",
        "arena-main.js",
        "rampage-main.js",
        "eventos-main.js",
        "times-main.js",
        "genetica-main.js",
        "expedicao-main.js",
        "awakening-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
