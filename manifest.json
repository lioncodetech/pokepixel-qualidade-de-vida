{
  "manifest_version": 3,
  "name": "PokePixel - qualidade de vida",
  "version": "1.4.1",
  "description": "As oito ferramentas de qualidade de vida do PokePixel num pacote so, com um menu para ligar e desligar cada uma. Alt+Q abre o menu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pokepixel.nietore.com/*",
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "nucleo.js",
        "ocultar-popups.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokepixel.nietore.com/*",
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "senha.js",
        "loja-rapida.js",
        "venda-rapida.js",
        "layout-padrao.js",
        "times.js",
        "gym.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pokepixel.nietore.com/*",
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "nucleo-main.js",
        "sem-grafico.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
